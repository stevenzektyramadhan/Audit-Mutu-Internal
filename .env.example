SPMI_EVIDENCE_STORAGE_BACKEND=local
APP_ENCRYPTION_KEY=replace-with-a-long-random-production-secret-minimum-32-chars

# ==============================================================================
# AUDIT MUTU INTERNAL (AMI) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to your secure environment location (e.g. /etc/environment,
# /etc/php/8.3/fpm/pool.d/ami.conf env[...], or your systemd service environment).
# DO NOT commit real passwords, keys, or tokens into version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & URL (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Environment: 'production', 'development', or 'testing'
CI_ENV=production

# Application Base URL (MUST use HTTPS in production and end with a trailing slash)
APP_BASE_URL=https://ami.unmuhbabel.ac.id/

# Enforce secure cookies (Must be true in production HTTPS)
APP_COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL 8.0+)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_USERNAME=ami_user
DB_PASSWORD=replace-with-a-secure-database-password
DB_DATABASE=ami

# ------------------------------------------------------------------------------
# 3. STORAGE & LOGS (PATHS MUST BE OUTSIDE WEBROOT IN PRODUCTION)
# ------------------------------------------------------------------------------
# Absolute path to private storage folder (permissions 0700 www-data:www-data)
APP_PRIVATE_STORAGE_PATH=/var/ami-storage/private

# Optional absolute path to public uploads folder (permissions 0775 www-data:www-data)
# Defaults to FCPATH/uploads if unset. When set outside webroot, configure web server
# alias or symlink for /uploads/ -> APP_PUBLIC_UPLOADS_PATH/
APP_PUBLIC_UPLOADS_PATH=/var/ami-storage/public_uploads

# Absolute path to application logs folder (permissions 0750 www-data:www-data)
APP_LOG_PATH=/var/log/ami/

# ------------------------------------------------------------------------------
# 4. EVIDENCE STORAGE BACKEND
# ------------------------------------------------------------------------------
# Backend: 'local' (default) or 'google_drive'
SPMI_EVIDENCE_STORAGE_BACKEND=local

# Optional Google Drive settings (only if SPMI_EVIDENCE_STORAGE_BACKEND=google_drive)
# In production, ONLY service_account is permitted. Path must be outside webroot.
# GOOGLE_DRIVE_AUTH_MODE=service_account
# GOOGLE_DRIVE_EVIDENCE_FOLDER_ID=your-google-drive-folder-id
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_PATH=/var/ami-storage/credentials/service-account.json
# GOOGLE_DRIVE_OAUTH_CLIENT_SECRET_JSON_PATH=
# GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN_JSON_PATH=

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (BREVO / SMTP)
# ------------------------------------------------------------------------------
# Transport: 'brevo' (default) or 'smtp'
MAIL_TRANSPORT=brevo

# If using Brevo API (recommended):
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=lpmpi@unmuhbabel.ac.id
BREVO_SENDER_NAME=LPMPI UNMUH BABEL

# If using SMTP:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_CRYPTO=tls
# SMTP_FROM_EMAIL=lpmpi@unmuhbabel.ac.id
# SMTP_FROM_NAME=LPMPI UNMUH BABEL

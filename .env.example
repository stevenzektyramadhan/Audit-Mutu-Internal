# Reference only. CodeIgniter does not load this file automatically.
# Inject these values through Apache, PHP-FPM, Docker/Kubernetes, or the
# deployment secret manager. Never commit a populated .env file.

CI_ENV=production
APP_BASE_URL=https://ami.example.ac.id/
APP_ALLOWED_HOSTS=ami.example.ac.id

# Leave empty for a direct deployment. If a reverse proxy is used, list only
# proxy IP addresses or CIDRs controlled by the deployment team.
APP_TRUSTED_PROXIES=

APP_ENCRYPTION_KEY=<set-in-deployment-secret-store>
APP_COOKIE_SECURE=true
APP_LOG_THRESHOLD=1

# These directories must already exist, be writable by the PHP service user,
# and be outside the public document root.
APP_LOG_PATH=/srv/ami/logs
APP_SESSION_SAVE_PATH=/srv/ami/sessions
APP_PRIVATE_STORAGE_PATH=/srv/ami/private

DB_HOST=<database-host>
DB_USERNAME=ami_app
DB_PASSWORD=<set-in-deployment-secret-store>
DB_DATABASE=ami

# Docker development only. Compose requires both values and has no password
# fallback in the repository. Do not reuse them for production.
AMI_DEV_DB_PASSWORD=<set-unique-local-docker-secret>
AMI_DEV_DB_ROOT_PASSWORD=<set-different-local-docker-secret>

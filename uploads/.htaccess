# Block PHP script execution and direct directory indexing inside uploads
Options -Indexes -ExecCGI

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|inc|cgi|pl|py|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Only apply php_flag when mod_php is loaded as an Apache module (not under PHP-FPM / FastCGI)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Prevent handler execution under mod_mime / SetHandler
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .inc
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .inc
</IfModule>

<?php
defined('BASEPATH') OR exit('No direct script access allowed');

/*
|--------------------------------------------------------------------------
| Production Configuration Overrides
|--------------------------------------------------------------------------
|
| File konfigurasi ini otomatis di-load oleh CodeIgniter 3 saat ENVIRONMENT === 'production'.
| Nilai di sini akan meng-override nilai di application/config/config.php.
|
*/

// Domain / Base URL production wajib diset secara eksplisit. // GANTI
$config['base_url'] = 'https://GANTI-DOMAIN.example/';

// Native Nginx template memakai front-controller rewrite.
$config['index_page'] = '';

// Kunci enkripsi wajib berupa secret acak deployment. // GANTI
$config['encryption_key'] = 'GANTI_DENGAN_ENCRYPTION_KEY_ACAK';

// Preset native: session disimpan di application/cache/sessions.
$config['sess_driver']     = 'files';
$config['sess_save_path']  = APPPATH . 'cache/sessions';
$config['cookie_secure']   = TRUE;
$config['cookie_httponly'] = TRUE;
$config['cookie_samesite'] = 'Lax';

// Proteksi CSRF
$config['csrf_protection'] = TRUE;

// Preset native: log disimpan di application/logs/ dan diblokir oleh Nginx.
$config['log_threshold'] = 1;
$config['log_path']      = APPPATH . 'logs/';

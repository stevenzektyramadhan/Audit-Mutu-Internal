<?php
defined('BASEPATH') OR exit('No direct script access allowed');

/*
|--------------------------------------------------------------------------
| Production Configuration Overrides
|--------------------------------------------------------------------------
|
| File konfigurasi ini otomatis di-load oleh CodeIgniter 3 saat ENVIRONMENT === 'production'.
| Nilai di sini akan meng-override nilai di application/config/config.php.
|
*/

// Domain / Base URL production wajib diset secara eksplisit
$config['base_url'] = 'https://ami.unmuhbabel.ac.id/';

// Index page (gunakan '' jika Nginx URL rewriting aktif, atau 'index.php')
$config['index_page'] = 'index.php';

// Kunci enkripsi wajib 32 karakter hex/string acak
$config['encryption_key'] = 'GANTI_DENGAN_ENCRYPTION_KEY_32_KARAKTER_HEX';

// Pengaturan Sesi & Keamanan Cookie
$config['sess_driver']     = 'files';
$config['sess_save_path']   = APPPATH . 'cache/sessions'; // atau path di luar webroot misal '/var/www/vhosts/ami/storage/sessions'
$config['cookie_secure']   = TRUE;
$config['cookie_httponly'] = TRUE;
$config['cookie_samesite'] = 'Lax';

// Proteksi CSRF
$config['csrf_protection'] = TRUE;

// Logging
$config['log_threshold']   = 1;
$config['log_path']        = APPPATH . 'logs/'; // atau path di luar webroot misal '/var/log/ami/'

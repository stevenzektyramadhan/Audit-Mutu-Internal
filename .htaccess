# ----------------------------------------------------------------------
# Apache Security and Rewrite Configuration for Audit Mutu Internal (CI3)
# ----------------------------------------------------------------------

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to hidden files/directories (except well-known ACME challenges)
    RewriteCond %{REQUEST_URI} !/\.well-known/ [NC]
    RewriteRule "(^|/)\." - [F,L]

    # Block direct access to sensitive directories
    RewriteRule ^(application|system|migrations|tests|backups|\.git|\.multibrain|\.omo|\.opencode|docker)(/|$) - [F,L]

    # Block direct access to sensitive root files and metadata
    RewriteRule ^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|tailwind\.config\.js|compose\.yaml|Dockerfile|database_.*\.sql|DESIGN\.md|AGENTS\.md|license\.txt)$ - [F,L]

    # Block direct access to private files in uploads
    RewriteRule ^uploads/(bukti_auditor|instrumen|penetapan|audit_evidence|ppepp_documents|user_photos|spmi_source|rtm_photos)(/|$) - [F,L]

    # Route request through index.php if file/dir does not physically exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>

# Fallback directory protection for Apache when mod_rewrite is inactive
<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|tailwind\.config\.js|compose\.yaml|Dockerfile|database_.*\.sql|DESIGN\.md|AGENTS\.md)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|tailwind\.config\.js|compose\.yaml|Dockerfile|database_.*\.sql|DESIGN\.md|AGENTS\.md)$">
        Deny from all
    </FilesMatch>
</IfModule>
